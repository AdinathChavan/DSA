class Solution {
    public int maximalRectangle(char[][] matrix) {

        int rows = matrix.length;
        int cols = matrix[0].length;

        int maxArea = 0;
        int[] height = new int[cols];

        for(int i=0; i<rows; i++){

            for(int j=0; j<cols; j++){

                if(matrix[i][j]=='1'){
                    height[j] +=1;
                }else{
                    height[j]=0;
                }
            }

            maxArea = Math.max(maxArea, largestRectangle(height));
        }
        return maxArea;
    }

    public int largestRectangle(int[] height){

        int max = 0;
        Stack<Integer> stack = new Stack<>();
        int n = height.length;

        for(int i=0; i<=n; i++){

            int h = i==n?0:height[i]; // when i reaches end consider right height 0

            while(!stack.isEmpty() && h < height[stack.peek()]){

                int heights = height[stack.pop()];
                int width = stack.isEmpty()?i: i-stack.peek()-1; // when i at start consider width as i;

                int area = heights*width;
                max = Math.max(area, max);
            }
            stack.push(i);
        }

        return max;
    }
}
