class Solution {
    public int numSubarrayProductLessThanK(int[] nums, int k) {

        int count=0;

        int n = nums.length-1;

        if(nums[n]<k){
            count++;
        }
        

        for(int i=0; i<nums.length-1; i++){
            int j = i+1;
            int sum =nums[i];// first number in sum i then multiply j with i.
            if(nums[i]<k){
                count++;
            }
            while(j<nums.length){
                sum = sum*nums[j];

                if(sum<k){
                   count++;
                   j++;
                }else{
                 break;
                }
            }
        }

        return count;
        
    }
}
