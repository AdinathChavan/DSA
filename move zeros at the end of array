package Practice;

public class ZeroEnd {

    public static void moveZeroEnd(int[] arr, int n){
        int j=-1;
        for(int i=0; i<arr.length; i++){
            if(arr[i]==0){
                j=i;
                break;
            }
        }
       if(j==-1) return;
       for(int i=j+1; i<arr.length; i++){
           if(arr[i]!=0){
               int temp = arr[j];
               arr[j]= arr[i];
               arr[i]=temp;

               j++;
           }
       }
        for(int e : arr){
            System.out.print(" "+e);
        }

    }


    public static void main(String[] args) {
        int[] arr = { 1,4,0,6,5,0,4,0,0,3,5,6};

        moveZeroEnd(arr, arr.length);

    }
}
