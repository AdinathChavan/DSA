class Solution {
    public boolean isHappy(int n) {

        Set<Integer> set  = new HashSet<>();

        while(true){

            int sum =0;
            
            while(n!=0){

                int num = n%10;
                sum+= Math.pow(num,2);
                n = n/10;
            }

            if(sum ==1){
                return true;
            }else{
                n=sum;
            }

            if(set.contains(sum)){
                return false;
            }else{
                set.add(sum);
            }
        }


        
}
}
