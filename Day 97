class Solution {
    public String maxSumOfSquares(int num, int sum) {


        if(num==1){
            if(sum<10){
                return String.valueOf(sum);
            }else{
                return "";
            }
        }

        StringBuffer str = new StringBuffer();
 

        while(num!=0){

            if(sum==0){
                str.append("0");
                num--;
            }
            else if(sum>9){

                int x = sum/9;

                while(x!=0 && num!=0){
                    str.append("9");
                    sum = sum-9;
                    x--;
                    num--;
                }
            }
            else{
                str.append(sum);
                sum =0;
                num--;
            }
        }

        if(sum!=0) return "";

        return str.toString();
        
    }
}
