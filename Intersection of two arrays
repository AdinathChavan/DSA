package Practice;

import java.util.Stack;

public class Intersection {
    public static Stack<Integer> intersection(int[] arr, int[] arr1){

        Stack<Integer> intersection = new Stack<>();
        int n = arr.length;
        int n1 = arr1.length;
        int i=0;
        int j=0;

        while(i<n && j<n1){

            if(arr[i]<arr1[j]){
                i++;
            }
            else if(arr1[j]<arr[i]){
                j++;
            }
            else{
                intersection.push(arr[i]);
                i++;
                j++;
            }
        }
        return intersection;
    }


    public static void main(String[] args) {
        int[] arr = { 1,2,3,4,5,6};
        int[] arr1 = { 4,5,6,7,8,9,9};

        Stack<Integer> temp = intersection(arr, arr1);

        temp.forEach(e-> System.out.print(e+" "));
    }
}
