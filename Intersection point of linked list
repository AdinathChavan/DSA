/**
 * Definition for singly-linked list.
 * public class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode(int x) {
 *         val = x;
 *         next = null;
 *     }
 * }
 */
public class Solution {
    public ListNode getIntersectionNode(ListNode headA, ListNode headB) {

        ListNode a = headA;
        ListNode b = headB;

        int lengthA=0;
        int lengthB=0;

        while(a!=null){
            a = a.next;
            lengthA++;
        }
        
        while(b!=null){
            b = b.next;
            lengthB++;
        }

        a = headA;
        b = headB;

        if(lengthB>lengthA){
            while(lengthB>lengthA){
                b = b.next;
                lengthB--;
            }
        }
        else{
            while(lengthA>lengthB){
                a = a.next;
                lengthA--;
            }
        }

        while(a!=b){
            a = a.next;
            b = b.next;
        }

        return a;
    }
}
