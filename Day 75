class Solution {

    public int findTargetSumWays(int[] nums, int target) {
        
        int sum =0;
        for(int i=0; i<nums.length; i++) sum+=nums[i];

         int[][] dp = new int[nums.length][sum+1];
         return solve(0,nums, target, dp, 0);
    
    }


    public int solve(int i, int[] nums, int target, int[][] dp, int sum){

        if(i==nums.length){
            if(sum==target){
                return 1;
            }
            return 0;
        }

        if(dp[i][sum]!=0) return dp[i][sum];
        int left = solve(i+1, nums, target, dp, sum+nums[i]);
        int right = solve(i+1, nums, target, dp, sum-nums[i]);

        return dp[i][sum]=left+right;
    }
}
