package Arrays;

public class NumberAppearOnce {

    public static int getNumberOnceApper(int [] arr){

        int xor =0;
        for(int e : arr){
            xor= xor^e;
        }
        return xor;
    }

    public static void main(String[] args) {

        int[] arr = { 1,2,3,4,5,1,2,4,5};

        System.out.println(getNumberOnceApper(arr));
    }
}
