package Arrays;

import java.util.ArrayList;
import java.util.List;

public class SpiralTraversalOfMatrix {

    public static List<Integer> spiralTraversal(int [][] arr, int n){
        int left = 0; int right=n-1;
        int top=0; int bottom=n-1;

        List<Integer> list = new ArrayList<>();

        while(left<=right && top<=bottom){

            for(int i=left; i<=right; i++){
                list.add(arr[top][i]);
            }
            top++;
            for(int i=top; i<=bottom; i++){
                list.add(arr[i][right]);
            }
            right--;

            if(top<=bottom){
                for(int i=right; i>=left; i--){
                    list.add(arr[bottom][i]);
                }
            }
            bottom--;
            if(left<=right){
                for(int i=bottom; i>=top; i--){
                    list.add(arr[i][left]);
                }
            }
            left++;

            list.add(99999);

        }

        return list;
    }


    public static void main(String[] args) {
        int[][] arr = { {12,34,46,57,4,5,6,},{23,1,2,3,7,8,9},{7,8,9,5,9,8,7},{10,20,30,40,8,7,8},{23,1,2,3,7,8,9},{23,1,2,3,7,8,9},{23,1,2,3,7,8,9}};

       List<Integer> list =  spiralTraversal(arr, 7);

       for(Integer e : list){
           System.out.println(e);
       }
    }
}
