class Solution {
    public int uniquePathsWithObstacles(int[][] mat) {

        int row = mat.length;
        int col = mat[0].length;


        int[][] dp = new int[row][col];

        for(int i=0; i<row; i++){

            for(int j=0; j<col; j++){

                if(mat[i][j]==1){
                    dp[i][j]=0;
                }
                else if(i==0 && j==0){
                    dp[i][j]=1;
                }else{
                    int left =0;
                    int right =0;

                    if(i>0) left = dp[i-1][j];
                    if(j>0) right = dp[i][j-1];

                    dp[i][j]= (left+right);
                }
            }
        }

        return dp[row-1][col-1];
        
    }
}
