class Solution {
    public List<List<Integer>> subsetsWithDup(int[] nums) {
        Arrays.sort(nums);
        List<List<Integer>> ans =  new ArrayList<>();
        List<Integer> list = new ArrayList<>();

        subsets(0,nums, ans, list);

        return ans;
        
    }

    public void subsets(int i, int[] nums, List<List<Integer>> ans, List<Integer> list){

        if(i==nums.length){
            ans.add(new ArrayList<>(list));
            return;
        }

        list.add(nums[i]);
        subsets(i+1, nums, ans, list);
        list.removeLast();
        i = i+1;
        while(i<nums.length && nums[i]==nums[i-1]){
            i++;
        }
        subsets(i, nums, ans, list);
    }
}
