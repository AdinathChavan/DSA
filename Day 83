class Solution {
    public int maxProfit(int k, int[] prices) {
        
        Integer[][][] dp = new Integer[prices.length][2][k+1];

        return solve(0,1,prices,k,dp);
    }

    public int solve(int i, int buy, int[] prices, int cap , Integer[][][] dp){

        if(i==prices.length || cap==0) return 0;

        if(dp[i][buy][cap]!=null) return dp[i][buy][cap];

        if(buy==1){
            return dp[i][buy][cap]= Math.max( -prices[i]+solve(i+1,0,prices,cap,dp), solve(i+1,1,prices,cap, dp));
        }else{
            return dp[i][buy][cap]=Math.max(  prices[i]+solve(i+1,1,prices,cap-1,dp), solve(i+1,0,prices,cap,dp));
        }
    }
}
