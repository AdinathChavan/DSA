class Solution {
    public int[] twoSum(int[] nums, int target) {
       
       HashMap<Integer, Integer> map = new HashMap<>();  

       for(int i=0; i<nums.length; i++){

          int currentSum = 0;
          currentSum = target-nums[i];

          if(map.containsKey(currentSum)){
            return new int[] {map.get(currentSum), i};
          }
          else{
            map.put(nums[i],i);
          }
       }

       return new int[]{-1,-1};
        
    }
}
