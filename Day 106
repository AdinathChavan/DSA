class Solution {
    public boolean isBipartite(int[][] graph) {

        int n = graph.length;

        int[] visited = new int[n];

        for(int i=0; i<n; i++){
            if(visited[i]==0){
                if(!dfs(i,1,graph, visited)){
                    return false;
                }
            }
        }

        return true;       
    }

    public boolean dfs(int node, int col, int[][] graph, int[] visited){

        visited[node]=col;

        for(int e : graph[node]){
            if(visited[e]==0){
                if(!dfs(e, -col, graph, visited)){
                    return false;
                }
            }else{
                if(visited[e]==col){
                    return false;
                }
            }
        }

        return true;
    }
}
