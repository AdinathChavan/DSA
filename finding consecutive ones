package Practice;

import java.util.List;

public class Consecutives {

    public static int consecutives(List<Integer> list){
        int count=0;
        int max = 0;

        for(int i=0; i<list.size(); i++){
            if(list.get(i)==1){
                count++;
                if(max<count){
                    max=count;
                }
            }
            else{
                count=0;
            }
        }
        return max;
    }

    public static void main(String[] args) {

        List<Integer> list = List.of(1,2,1,1,1,4,5,6,1,1,1,1,3,2,1,4);
        
        int max =  consecutives(list);
        System.out.println(max);
    }
}
