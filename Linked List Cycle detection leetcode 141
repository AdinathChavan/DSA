public class Solution {
    public boolean hasCycle(ListNode head) {
        ListNode fast = head;
        ListNode slow = head;

        while (fast != null && fast.next != null) {
            fast = fast.next.next;  // two node at a time.
            slow = slow.next;       // single node at a time.

            if (fast == slow) {
                return true;
            }
        }

        return false;        
    }
}
