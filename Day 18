class Solution {
    public boolean hasTripletSum(int arr[], int target) {
       
       
        Arrays.sort(arr);
        
        int sum = 0;
        
        for(int left =0; left<arr.length; left++){
            
            int j= left+1;
            int right = arr.length-1;
            
            while(j<right){
                
                sum = arr[left]+arr[right]+arr[j];
                
                if(sum<target){
                    j++;
                }
                else if(sum>target){
                    right--;
                }else{
                    return true;
                }
            }
        
        }
        
        return false;
        
    }
}
