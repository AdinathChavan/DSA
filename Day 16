class Solution {
    public int lengthOfLastWord(String s) {
        

        int start = 0;
        int count = 0;

        for(int i=s.length()-1; i>=0; i--){

            if(s.charAt(i)!=' '){
                start = i;
                count++;
            }
            else if(count>0 && s.charAt(i)==' '){
                return count;
            }else{
                count=0;
            }
        }

        return count;
    }
}
