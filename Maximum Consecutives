package Arrays;

public class MaximumConsecutives {

    public static int findConsecutives(int[] arr){

        int max = 0;
        int count=0;

        for(int i=0; i<arr.length; i++){

            if(arr[i]==1){
                count++;
                if(max<count) max=count;
            }
            else{
                count=0;
            }
        }

        return max;
    }

    public static void main(String[] args) {

        int[] arr = {1,1,3,5,3,1,2,1,1,1,1,2,5};

        System.out.println(findConsecutives(arr));
    }
}
