class Solution {
    public int searchInsert(int[] nums, int target) {
        int index=-1;
        int n = nums.length-1;

        if(n==0){
            if(nums[0]==target){
                return 0;
            }
            else if(nums[0]>target){
                return 0;
            }else{
                return 1;
            }
        }

        for(int i=0; i<=n; i++)
        {
            if(nums[i]==target){
                index= i;
            }
        }

        if(index==-1)
        {
            int i = 0;
            while(i<n){
                if(nums[i]<target && nums[i+1]>target){
                    index=i+1;
                    return index;
                }  
                 else if(nums[n]<target){
                    index=n+1;
                    return index;
                }
                else if(nums[0]>target){
                    index=0;
                   return index;
                }
                else{
                    i++;
                }
            }
        }

        return index;
        
    }
}
