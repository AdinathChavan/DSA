class Solution {
    public int addDigits(int num) {

       int n = num;

       while(n>9){
        int result = add(n);
        n = result;
       }

       return n;
        
    }

    public int add(int n){
        int sum = 0;

        while(n!=0){
            int k = n%10;
            sum +=k;
            n = n/10;
        }
        return sum;
    }
}
