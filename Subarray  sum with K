package Arrays;

public class SubarrayWithSumK {

    public static int subarraySum(int k, int[] arr){

        int max=Integer.MIN_VALUE;
        int n= k-1;
        int id1=0;
        int id2=0;
        for(int i=0; i<arr.length-n; i++){
            int sum=0;
            for(int j=i; j<=i+n; j++){
                sum+=arr[j];
            }
            if(sum>max){
                max=sum;
            }
        }
        return max;
    }

    public static void main(String[] args) {

        int[] arr = { 1,3,6,3,4,2,5};

        int result = subarraySum(4,arr);

        System.out.println(result);
    }
}
